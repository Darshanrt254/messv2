# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE - SWAYAMSIDDHA BACKEND
# ==============================================================================
# Copy this file to .env and customize for your local development environment.
# DO NOT commit real secrets or production credentials to source control.

# Server Configuration
PORT=5000
NODE_ENV="development"

# PostgreSQL connection string
# Local development default:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/swayamsiddha_dev?schema=public"

# Session & Security Configuration
SESSION_SECRET="replace_with_a_secure_random_secret_in_production"
SESSION_COOKIE_NAME="swayamsiddha_session"
SESSION_MAX_AGE_DAYS=7

# Allowed Frontend Origin (for CORS with credentials)
FRONTEND_ORIGIN="http://localhost:5173"

# Optional development seed passwords (for local prisma/seed.js only)
SEED_OWNER_PASSWORD="change_this_dev_owner_password"
SEED_CUSTOMER_PASSWORD="change_this_dev_customer_password"
